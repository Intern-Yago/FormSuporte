version: '3.8'

services:
  # Serviço principal do Monólito Django
  web:
    build: .
    container_name: formsuporte_web
    command: daphne -b 0.0.0.0 -p 8000 Form_Suporte.asgi:application
    volumes:
      - .:/app
    ports:
      - "8000:8000"
    env_file:
      - .env
    depends_on:
      - redis
      - db

  # Banco de Dados (PostgreSQL recomendado)
  db:
    image: postgres:15-alpine
    container_name: formsuporte_db
    volumes:
      - postgres_data:/var/lib/postgresql/data
    environment:
      - POSTGRES_DB=servidoreaata
      - POSTGRES_USER=admin
      - POSTGRES_PASSWORD=password
    ports:
      - "5432:5432"

  # Redis para o Django Channels (WebSockets)
  redis:
    image: redis:7-alpine
    container_name: formsuporte_redis
    ports:
      - "6379:6379"

  # MinIO (Opcional: se desejar rodar o storage localmente)
  minio:
    image: minio/minio
    container_name: formsuporte_minio
    ports:
      - "9000:9000"
      - "9001:9001"
    environment:
      - MINIO_ROOT_USER=minioadmin
      - MINIO_ROOT_PASSWORD=minioadmin
    command: server /data --console-address ":9001"

volumes:
  postgres_data:
  minio_data:
