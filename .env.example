# ===================== DJANGO SETTINGS =====================
SECRET_KEY=sua_chave_secreta_aqui
DEBUG=True
DJANGO_ENV=dev
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=https://url.com.br

# ===================== DATABASE (POSTGRES / MYSQL / SQLITE) =====================
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# ===================== REDIS & CHANNELS (WEBSOCKETS) =====================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ===================== ERP ODOO (XML-RPC) =====================
ODOO_URL=https://odoo.exemplo.com
ODOO_DB=base_dados_odoo
ODOO_USER=usuario_odoo
ODOO_PASSWORD=senha_odoo

# ===================== GATEWAY REDE (PAYMENTS) =====================
REDE_SANDBOX=1
REDE_CLIENT_ID=seu_client_id_rede
REDE_CLIENT_SECRET=seu_client_secret_rede
REDE_WEBHOOK_REGISTER_IN_SANDBOX=1
REDE_WEBHOOK_USE_AUTH=0
REDE_WEBHOOK_AUTH_TOKEN=
REDE_WEBHOOK_AUTH_ENABLED=0

# ===================== STORAGE (MINIO / S3) =====================
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_BUCKET_MAIN=meu_bucket_principal
AWS_QUERYSTRING_AUTH=0

# ===================== TRADUÇÃO (DEEPL API) =====================
DEEPL_AUTH_KEY=sua_chave_deepl_aqui

# ===================== SHOPIFY (GRAPHQL API) =====================
SHOPIFY_STORE_URL=sua-loja.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_seu_token_aqui

# ===================== SSO & BLOCKUNBLOCK =====================
BLOCK_UNBLOCK_BASE_URL=http://localhost:8001
BLOCK_UNBLOCK_FRONTEND_URL=http://localhost:3000
BLOCK_UNBLOCK_SSO_URL=http://localhost:8001/sso/
SITUACAO_WEBHOOK_TOKEN=seu_token_seguro_aqui

# ===================== OUTROS =====================
PUBLIC_BASE_URL=http://localhost:8000
